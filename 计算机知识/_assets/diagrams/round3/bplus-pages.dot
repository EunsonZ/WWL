digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.28",nodesep="0.42",ranksep="0.6",fontname="Noto Sans CJK SC",fontsize=21,label="B+ 树：内部导航，叶层承载有序条目",labelloc=t,size="13,9"];
