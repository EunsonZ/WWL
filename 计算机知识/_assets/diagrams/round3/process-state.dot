digraph G {
graph [rankdir=LR,bgcolor="white",pad="0.28",nodesep="0.42",ranksep="0.6",fontname="Noto Sans CJK SC",fontsize=21,label="进程状态：等待 CPU 与等待事件不是同一件事",labelloc=t,size="13,9"];
node [shape=box,style="rounded,filled",fillcolor="#F3F6FA",color="#44566C",fontname="Noto Sans CJK SC",fontsize=15,margin="0.16,0.12"];
edge [color="#44566C",fontname="Noto Sans CJK SC",fontsize=12,arrowsize=0.7];
"new" [label="新建"];
"ready" [label="就绪"];
"run" [label="运行"];
"wait" [label="阻塞 / 等待"];
"end" [label="退出"];
"new" -> "ready";
"ready" -> "run" [label="调度"];
"run" -> "ready" [label="抢占"];
"run" -> "wait" [label="等待 I/O / 锁"];
"wait" -> "ready" [label="事件完成"];
"run" -> "end";

}