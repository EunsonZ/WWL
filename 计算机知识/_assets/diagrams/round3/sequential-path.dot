digraph G {
graph [rankdir=LR,bgcolor="white",pad="0.28",nodesep="0.42",ranksep="0.6",fontname="Noto Sans CJK SC",fontsize=21,label="同步路径时序：时钟周期必须容纳数据传播",labelloc=t,size="13,9"];
