filters:
  and:
    - or:
      - file.inFolder("Obsidian知识/20-功能/01-官方插件实验室")
      - file.inFolder("Obsidian知识/20-功能/02-社区插件实验室")
    - type == "lesson"
    - or:
      - file.hasTag("playground/core-plugins")
      - file.hasTag("playground/community-plugins")

properties:
  file.name:
    displayName: 实验
  note.plugin:
    displayName: 插件
  note.stage:
    displayName: 阶段
  note.difficulty:
    displayName: 难度
  note.status:
    displayName: 状态
  note.estimated_minutes:
    displayName: 预计分钟
  note.topics:
    displayName: 主题
  note.risk:
    displayName: 风险
  note.platforms:
    displayName: 平台

views:
  - type: table
    name: 插件实验
    order:
      - file.name
      - plugin
      - stage
      - difficulty
      - status
      - estimated_minutes
      - topics
      - risk
      - platforms
      - file.tags
    sort:
      - property: stage
        direction: ASC
      - property: file.name
        direction: ASC
  - type: list
    name: 实验清单
    order:
      - file.name
      - plugin
      - difficulty
      - status
      - estimated_minutes
