digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.28",nodesep="0.42",ranksep="0.6",fontname="Noto Sans CJK SC",fontsize=21,label="服务生命周期：进程启动与业务就绪分开验收",labelloc=t,size="10,14"];
node [shape=box,style="rounded,filled",fillcolor="#F3F6FA",color="#44566C",fontname="Noto Sans CJK SC",fontsize=15,margin="0.16,0.12"];
edge [color="#44566C",fontname="Noto Sans CJK SC",fontsize=12,arrowsize=0.7];
"0" [label="启动进程"];
"1" [label="初始化配置与依赖"];
"2" [label="报告就绪\n开始接受请求"];
"3" [label="收到停止请求\n停止接入、排空"];
"4" [label="清理并退出"];
"0" -> "1";
"1" -> "2";
"2" -> "3";
"3" -> "4";

}