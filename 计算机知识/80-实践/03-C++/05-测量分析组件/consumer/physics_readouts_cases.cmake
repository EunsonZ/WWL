file(READ "${DATA}" good)
file(MAKE_DIRECTORY "${OUTPUT}")
function(reject name content)
  file(WRITE "${OUTPUT}/${name}.txt" "${content}")
  execute_process(COMMAND "${CONSUMER}" "${OUTPUT}/${name}.txt"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
  if(NOT rc EQUAL 2 OR NOT err MATCHES "physical_consumer_error=")
    message(FATAL_ERROR "${name}: expected input failure, got ${rc}")
  endif()
endfunction()
string(REPLACE "thermal 1 6" "thermal 0.001 6" wrong_time "${good}")
reject(wrong_seconds "${wrong_time}")
string(REPLACE "thermal 1 6 0" "thermal 1 6 4096" bad_code "${good}")
reject(bad_code "${bad_code}")
string(REPLACE "thermal 1 6 0" "thermal 1 6 true" bool_token "${good}")
reject(bool_token "${bool_token}")
string(REPLACE "diode 0 6" "diode 1 6" invented_time "${good}")
reject(sweep_is_not_time "${invented_time}")
reject(truncated "thermal 1 6 0 761\n")
reject(extra_channel "${good}diode 0 0\n")
