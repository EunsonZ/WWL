digraph G {
    graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.5", fontname="Noto Sans CJK SC", fontsize=21, labelloc="t", label="损失分母决定实际训练目标"];
    node [shape=box, style="rounded,filled", fillcolor="#edf4fa", color="#456782", fontname="Noto Sans CJK SC", fontsize=14, margin="0.15,0.12"];
    edge [fontname="Noto Sans CJK SC", fontsize=12, color="#4f6474", arrowsize=0.7];
    
    a [label="微批 A
9 个有效 token
平均损失 1 → 损失和 9"];
    b [label="微批 B
1 个有效 token
平均损失 9 → 损失和 9"];
    good [label="按全窗口 token 归一化
(9 + 9) / (9 + 1) = 1.8", fillcolor="#e6f3e9"];
    bad [label="直接平均两个微批均值
(1 + 9) / 2 = 5
改变了样本权重", fillcolor="#fff3de"];
    ddp [label="DDP 默认平均各 rank 梯度
本地目标：R × 本地损失和 / 全局计数
零 token 的 rank 也需参与约定的通信"];
    a -> good;b -> good;a -> bad;b -> bad;good -> ddp;
    
    }