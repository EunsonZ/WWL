digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.45", label="扩散：训练已知加噪，生成学习反向过程", labelloc="t", fontsize=22, fontname="Noto Sans CJK SC"];
 node [shape=box, style="rounded", margin="0.16,0.12", fontsize=16, fontname="Noto Sans CJK SC"];
