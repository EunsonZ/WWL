execute_process(COMMAND "${CLI}" "${DATA}/invalid.txt" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 2 OR NOT err MATCHES "complete decimal ADC code")
  message(FATAL_ERROR "invalid input must exit 2 with parser diagnostic: ${status}, ${err}")
endif()
execute_process(COMMAND "${CLI}" "${DATA}/missing.txt" RESULT_VARIABLE status ERROR_VARIABLE err)
if(NOT status EQUAL 2 OR NOT err MATCHES "cannot open")
  message(FATAL_ERROR "missing file must exit 2: ${status}, ${err}")
endif()
execute_process(COMMAND "${FIRST}" INPUT_FILE "${DATA}/codes.txt" RESULT_VARIABLE status OUTPUT_VARIABLE out)
if(NOT status EQUAL 0 OR NOT out MATCHES "count=4 sum_mV=20 mean_mV=5")
  message(FATAL_ERROR "first program mismatch: ${status}, ${out}")
endif()
execute_process(COMMAND "${FIRST}" INPUT_FILE "${DATA}/invalid.txt" RESULT_VARIABLE status ERROR_VARIABLE err)
if(NOT status EQUAL 2 OR NOT err MATCHES "invalid ADC")
  message(FATAL_ERROR "first program must reject invalid input: ${status}, ${err}")
endif()
