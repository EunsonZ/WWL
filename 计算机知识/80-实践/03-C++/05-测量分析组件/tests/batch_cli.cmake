execute_process(COMMAND "${CLI}" --workers 2 --capacity 1 "${DATA}/codes.txt" "${DATA}/invalid.txt" "${DATA}/codes.txt"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT status EQUAL 2 OR NOT output MATCHES "task=0 completed" OR NOT output MATCHES "task=1 failed" OR NOT output MATCHES "task=2 completed")
  message(FATAL_ERROR "mixed tasks failed: ${status} ${output} ${error}")
endif()
foreach(args IN ITEMS "--workers;0" "--workers;4" "--capacity;0" "--capacity;9" "--workers;x" "--unknown;2")
  execute_process(COMMAND "${CLI}" ${args} "${DATA}/codes.txt" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT status EQUAL 2)
    message(FATAL_ERROR "invalid arguments accepted: ${args} status=${status}")
  endif()
endforeach()
execute_process(COMMAND "${CLI}" "${DATA}/missing-file.txt" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT status EQUAL 2 OR NOT error MATCHES "cannot open batch input")
  message(FATAL_ERROR "missing file contract: ${status} ${error}")
endif()
