digraph G {
graph [rankdir=LR,bgcolor="white",pad="0.28",nodesep="0.42",ranksep="0.6",fontname="Noto Sans CJK SC",fontsize=21,label="干涉图：三个两两冲突的值至少需要三种颜色",labelloc=t,size="13,9"];
node [shape=box,style="rounded,filled",fillcolor="#F3F6FA",color="#44566C",fontname="Noto Sans CJK SC",fontsize=15,margin="0.16,0.12"];
edge [color="#44566C",fontname="Noto Sans CJK SC",fontsize=12,arrowsize=0.7];
"a" [label="a"];
"b" [label="b"];
"c" [label="c"];
"note" [label="只有 2 个寄存器时\n需要 spill 或改写代码"];
a -> b [dir=none]; b -> c [dir=none]; c -> a [dir=none]; c -> note [style=dashed];
}