digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.26", nodesep="0.32", ranksep="0.52", fontname="Noto Sans CJK SC", fontsize=19, labelloc="t", label="新标记作用于旧标记之后"];
node [shape=box, style="rounded,filled", fillcolor="#f7f9fb", color="#7891a5", penwidth=1.2, margin="0.18,0.12", fontname="Noto Sans CJK SC", fontsize=13];
edge [fontname="Noto Sans CJK SC", fontsize=11, color="#50687b", arrowsize=0.75];

  old [label="旧操作 f(x)=2x+1"];
  newer [label="新操作 g(x)=3x+4"];
  seq [label="原值 x → 2x+1 → 3(2x+1)+4\n正确组合 g∘f：6x+7",fillcolor="#e6eff8"];
  reverse [label="误写成 f∘g：2(3x+4)+1=6x+9\n顺序不能随意交换",fillcolor="#fff0df"];
  summary [label="节点摘要 (sum,len)\n(a,b) 作用后：(a·sum+b·len, len)"];
  assign [label="赋值 v：标记 (0,v)\n增加 d：(1,d)；单位操作：(1,0)"];
  old->seq;newer->seq;{rank=same;old;newer};seq->summary;seq->reverse[style=dashed];summary->assign;

}
