11 MOS OTA and resistor-sensed CMFB
.options reltol=1e-8 abstol=1e-15 vntol=1e-10 gmin=1e-18
.temp 27
.model NN NMOS LEVEL=1 KP=100u VTO=.6 LAMBDA=.04 GAMMA=0 PHI=.6 TNOM=27 TOX=1e3 IS=1e-30 CGSO=0 CGDO=0 CGBO=0 CBD=0 CBS=0
.model PP PMOS LEVEL=1 KP=50u VTO=-.7 LAMBDA=.04 GAMMA=0 PHI=.6 TNOM=27 TOX=1e3 IS=1e-30 CGSO=0 CGDO=0 CGBO=0 CBD=0 CBS=0
VDD vdd 0 3.3
VREF ref 0 1.65
IREF vdd vb 5e-05
VD ud 0 DC 0 AC 1
VCIN uc 0 DC 0 AC 0
BGP gp 0 V={1.5+v(uc)+.5*(v(ud)+0.1*(v(op)-v(om)))}
BGM gm 0 V={1.5+v(uc)-.5*(v(ud)+0.1*(v(op)-v(om)))}
M1 op gp s 0 NN W=4u L=1u
M2 om gm s 0 NN W=4u L=1u
M3 op vc vdd vdd PP W=4e-06 L=1u
M4 om vc vdd vdd PP W=4e-06 L=1u
M5 s vb 0 0 NN W=10u L=1u
M6 vb vb 0 0 NN W=10u L=1u
M7 vm sense sc 0 NN W=1u L=50u
M8 vc ref sc 0 NN W=1u L=50u
M9 sc vb 0 0 NN W=1u L=10u
M10 vm vm vdd vdd PP W=1u L=50u
M11 vc vm vdd vdd PP W=1u L=50u
R1 op sense 200000
R2 om sense 200000
C_op op 0 2e-11
C_om om 0 2e-11
C_s s 0 5e-12
C_vb vb 0 5e-12
C_sense sense 0 5e-12
C_sc sc 0 5e-12
C_vm vm 0 5e-12
C_vc vc 0 2e-11
.control
set noaskquit
set numdgt=15
tran .2u 2m uic
set wr_vecnames
set wr_singlescale
wrdata transient.txt v(op) v(om) v(s) v(vb) v(sense) v(sc) v(vm) v(vc)
quit
.endc
.ic v(op)=1.664238020580274 v(om)=1.663238020580274 v(s)=0.5563338802682972 v(vb)=0.9106211989967088 v(sense)=1.653738020580274 v(sc)=0.5689610545550181 v(vm)=1.91493002012166 v(vc)=2.119014232116687
.end
