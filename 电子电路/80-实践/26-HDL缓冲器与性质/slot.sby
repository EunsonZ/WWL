[tasks]
bmc
prove
cover
mutant
[options]
timeout 45
bmc: mode bmc
bmc: depth 12
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 12
mutant: mode bmc
mutant: depth 12
[engines]
smtbmc boolector
[script]
mutant: read_verilog -formal -sv -D U26_FAULT_OVERWRITE elastic_slot.sv slot_properties.sv
~mutant: read_verilog -formal -sv elastic_slot.sv slot_properties.sv
prep -top slot_properties
async2sync
dffunmap
[files]
elastic_slot.sv
slot_properties.sv
