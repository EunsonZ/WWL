execute_process(COMMAND "${CLI}" --input "${DATA}/codes.txt" --window 2 --hop 1 --gain-uv 1000 --offset-uv 0 --interval-ms 1000 --label adc RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(READ "${DATA}/report-reference.txt" expected)
if(NOT status EQUAL 0 OR NOT out STREQUAL expected)
  message(FATAL_ERROR "default window report mismatch: ${status}, ${out}, ${err}")
endif()
execute_process(COMMAND "${CLI}" --input "${DATA}/codes.txt" --window 2 --gain-uv 500 --offset-uv 1000 --interval-ms 250 --label sensor-A --output "${OUTPUT}" RESULT_VARIABLE status ERROR_VARIABLE err)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "configured output failed: ${status}, ${err}")
endif()
file(READ "${OUTPUT}" report)
file(READ "${DATA}/report-calibrated-reference.txt" expected)
if(NOT report STREQUAL expected)
  message(FATAL_ERROR "configured report contents mismatch: ${report}")
endif()
execute_process(COMMAND "${CLI}" --input "${DATA}/codes.txt" --window 0 RESULT_VARIABLE status ERROR_VARIABLE err)
if(NOT status EQUAL 2 OR NOT err MATCHES "window and hop")
  message(FATAL_ERROR "invalid window must exit 2 with range diagnostic: ${status}, ${err}")
endif()
execute_process(COMMAND "${CLI}" --input "${DATA}/codes.txt" --output "${OUTPUT}/child.txt" RESULT_VARIABLE status ERROR_VARIABLE err)
if(NOT status EQUAL 2 OR NOT err MATCHES "cannot open report output")
  message(FATAL_ERROR "bad output path must exit 2: ${status}, ${err}")
endif()
execute_process(COMMAND "${CLI}" --input "${DATA}/invalid.txt" RESULT_VARIABLE status ERROR_VARIABLE err)
if(NOT status EQUAL 2 OR NOT err MATCHES "complete decimal ADC code")
  message(FATAL_ERROR "bad input must exit 2: ${status}, ${err}")
endif()
execute_process(COMMAND "${CLI}" --input "${DATA}/empty.txt" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 0 OR NOT out MATCHES "count=0.*windows=0")
  message(FATAL_ERROR "empty report mismatch: ${status}, ${out}, ${err}")
endif()
