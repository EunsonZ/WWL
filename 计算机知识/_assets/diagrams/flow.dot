digraph G {
graph [charset="UTF-8", bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.5];
node [shape=box, style="rounded,filled", fillcolor="#F1F5F9", color="#64748B", fontname="Noto Sans CJK SC", fontsize=13, margin="0.14,0.10"];
edge [color="#475569", fontname="Noto Sans CJK SC", fontsize=10, arrowsize=0.7];
rankdir=LR;
subgraph cluster_initial {label="原图：每条边容量为 1";fontname="Noto Sans CJK SC";
s [label="s"];a [label="a"];b [label="b"];t [label="t"];
s->a [label="1"];s->b [label="1"];a->b [label="1"];a->t [label="1"];b->t [label="1"];
}
subgraph cluster_residual {label="第一次走 s-a-b-t 后的第二次增广";fontname="Noto Sans CJK SC";
s2 [label="s"];b2 [label="b"];a2 [label="a"];t2 [label="t"];
s2->b2 [label="新增流"];b2->a2 [label="反向边：撤回 a-b 的旧流",style=dashed];a2->t2 [label="新增流"];
}
t->s2 [style=invis];

}
