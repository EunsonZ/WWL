+        b0, b1, b2, a0, a1, a2 = values
+        exact = [Fraction(v) for v in values]
+        eb0, eb1, eb2, ea0, ea1, ea2 = exact
+        if ea0 != 1 or eb0 == 0:
+            raise ValueError('normalized nonzero binomial numerator required')
